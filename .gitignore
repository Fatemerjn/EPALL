# ---------------------------------------------------------------------------
# Experiment artifacts
#
# Raw runs, logs and datasets are regenerated by the commands in README.md and
# are far too large to version.  Only the curated thesis snapshot under
# results/thesis/plots_v2/ is tracked.
# ---------------------------------------------------------------------------
data/
logs/
runs/
runs_archive/
output/
tmp/
checkpoints/
pretrained/
*.ckpt
*.pt
*.pth

comparison_*.csv
comparison_*.md
results_*.csv

results/*
!results/thesis/
results/thesis/*
!results/thesis/plots_v2/
!results/thesis/plots_v2/adapter_bottleneck_ablation.pdf
!results/thesis/plots_v2/au_bars_by_dataset_regime.pdf
!results/thesis/plots_v2/final_accuracy_bars_by_dataset_regime.pdf
